# Supabase & Google OAuth Configuration
# 1. Enable Google provider in Supabase Dashboard: Authentication -> Providers -> Google
# 2. Add Authorized Redirect URI in Google Cloud Console: https://<your-project>.supabase.co/auth/v1/callback
# 3. Enter your Supabase project URL and anon/service keys below:
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
NEXT_PUBLIC_ECOMMERCE_STORE_SLUG="carxen"

# VEDA Database (Optional if using pooled Supabase DB)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
JWT_SECRET="carxen-local-dev-jwt-secret-key-32chars"
DATABASE_POOL_LIMIT=5

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_mockKeyId123"
RAZORPAY_KEY_ID="rzp_test_mockKeyId123"
RAZORPAY_KEY_SECRET="mockKeySecret123"
RAZORPAY_WEBHOOK_SECRET="mockWebhookSecret123"
